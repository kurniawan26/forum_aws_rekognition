<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- Hero --%>
  <div class="py-20 sm:py-28 text-center">
    <div class="mx-auto max-w-2xl space-y-6">
      <div class="flex justify-center">
        <div class="size-16 rounded-2xl bg-primary/10 flex items-center justify-center ring-1 ring-primary/20">
          <.icon name="hero-chat-bubble-left-right" class="size-8 text-primary" />
        </div>
      </div>

      <h1 class="text-4xl font-bold tracking-tight text-base-content sm:text-5xl">
        Welcome to <span class="text-primary">Forum</span>
      </h1>

      <p class="text-lg text-base-content/60 leading-relaxed">
        A community-driven discussion platform with intelligent image recognition powered by AWS Rekognition.
        Create threads, share ideas, and connect with others.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <div :if={@current_scope}>
          <.link navigate={~p"/threads"} class="btn btn-primary btn-lg gap-2">
            Browse Threads
            <.icon name="hero-arrow-right" class="size-5" />
          </.link>
        </div>
        <div :if={!@current_scope} class="flex flex-col sm:flex-row gap-3">
          <.link href={~p"/users/register"} class="btn btn-primary btn-lg gap-2">
            Get Started
            <.icon name="hero-arrow-right" class="size-5" />
          </.link>
          <.link href={~p"/users/log-in"} class="btn btn-ghost btn-lg">
            Log in
          </.link>
        </div>
      </div>
    </div>
  </div>

  <%!-- Features --%>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 pb-20">
    <div class="card bg-base-100 border border-base-300 hover:border-primary hover:shadow-sm transition-all">
      <div class="card-body items-center text-center gap-3">
        <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center">
          <.icon name="hero-chat-bubble-left-right" class="size-5 text-primary" />
        </div>
        <h3 class="font-semibold text-base-content">Community Discussions</h3>
        <p class="text-sm text-base-content/60">
          Create and join threads to discuss topics with your community in real time.
        </p>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 hover:border-primary hover:shadow-sm transition-all">
      <div class="card-body items-center text-center gap-3">
        <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center">
          <.icon name="hero-photo" class="size-5 text-primary" />
        </div>
        <h3 class="font-semibold text-base-content">Image Recognition</h3>
        <p class="text-sm text-base-content/60">
          Share images and let AWS Rekognition analyze and label them automatically.
        </p>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 hover:border-primary hover:shadow-sm transition-all">
      <div class="card-body items-center text-center gap-3">
        <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center">
          <.icon name="hero-shield-check" class="size-5 text-primary" />
        </div>
        <h3 class="font-semibold text-base-content">Secure & Private</h3>
        <p class="text-sm text-base-content/60">
          Your threads are scoped to your account. Share only with the people you trust.
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
